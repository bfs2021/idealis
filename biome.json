{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!assets",
      "!.mutator",
      "!.artifacts",
      "!test-results",
      "!playwright-report",
      "!evals/runs",
      "!evals/fixtures",
      "!evals/rust-probe/target",
      "!crates/idealis-smt/target",
      "!crates/ralloy/target",
      "!crates/idealis-testing/target",
      "!crates/oracle/target",
      "!evals/oracle-comparison/rust/target",
      "!evals/workspace-oracle/rust/target",
      "!evals/roracle-native/rust/target",
      "!evals/roracle-wit/rust/target",
      "!evals/roracle-wit/generated/*.js",
      "!evals/roracle-wit/toolchain/pnpm-lock.yaml",
      "!evals/controlled-schedules/rust/target",
      "!evals/structured-fuzz/rust/target",
      "!evals/structured-fuzz/fuzz/target",
      "!evals/structured-fuzz/fuzz/artifacts",
      "!evals/structured-fuzz/fuzz/corpus",
      "!evals/sat-foundation/rust/target",
      "!evals/shared-oracle-rust/target",
      "!crates/idealis-core/target",
      "!crates/rtlc/target",
      "!crates/rtla/target",
      "!crates/rtla-compiler/target",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["evals/roracle-wit/generated/**"],
      "linter": { "enabled": false },
      "assist": { "enabled": false }
    }
  ]
}
